  "faq": [
    {
      "q": "Vem får utfärda fullmakt för ett aktiebolag?",
      "a": "Endast styrelseledamot, VD eller annan firmatecknare har rätt att utfärda fullmakt för bolagets räkning."
    },
    {
      "q": "Behöver fullmakten registreras hos Bolagsverket?",
      "a": "Generellt inte, men vissa typer av fullmakter (t.ex. prokura) ska registreras enligt prokuralagen."
    },
    {
      "q": "Kan fullmakten gälla flera år?",
      "a": "Ja. Företagsfullmakter gäller ofta tillsvidare eller flera år. Specificera dock alltid en tidsgräns för säkerhets skull."
    },
    {
      "q": "Hur återkallas en företagsfullmakt?",
      "a": "Beslut om återkallelse fattas av samma organ som utfärdade fullmakten. Skriftlig återkallelse skickas till ombudet och berörda parter."
    },
    {
      "q": "Gäller fullmakten vid VD-byte?",
      "a": "Det beror på fullmaktens utformning. Om fullmakten utfärdats av bolaget (inte personligen av VD) gäller den vidare efter VD-byte."
    }
