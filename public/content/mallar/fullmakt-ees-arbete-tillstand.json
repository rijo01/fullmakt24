  "faq": [
    {
      "q": "Vad är en apostille?",
      "a": "En apostille är ett intyg från Notarius Publicus som bekräftar att en svensk myndighets eller notaries underskrift är äkta. Krävs för många utländska myndigheter."
    },
    {
      "q": "Var ansöker jag om apostille?",
      "a": "Hos Notarius Publicus i Sverige. Listan finns på regeringen.se. Avgift tas ut per dokument."
    },
    {
      "q": "Behöver fullmakten översättas?",
      "a": "Ja, oftast krävs auktoriserad översättning till mottagarlandets språk eller engelska."
    },
    {
      "q": "Vad är skillnaden mellan apostille och legalisering?",
      "a": "Apostille gäller för länder som undertecknat Haagkonventionen (1961). För andra länder krävs legalisering via UD och landets ambassad."
    },
    {
      "q": "Kan svensk fullmakt användas direkt utomlands?",
      "a": "Ibland, men oftast krävs apostille eller legalisering plus översättning. Kontakta landets ambassad i förväg."
    }
